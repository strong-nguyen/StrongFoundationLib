{
    "version": 3,
    "configurePresets": [
        {
            "name": "base-config",
            "hidden": true,
            "displayName": "Vcpkg Linux Configuration",
            "description": "Cấu hình chuẩn sử dụng vcpkg toolchain và Make",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Linux Debug",
            "description": "Cấu hình Debug với vcpkg và Make",
            "inherits": "base-config",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Linux Release",
            "description": "Cấu hình Release (Tối ưu hiệu năng) với vcpkg và Make",
            "inherits": "base-config",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}